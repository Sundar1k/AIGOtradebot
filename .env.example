# TopstepX API credentials (required for live/paper trading)
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT=

# Selection funnel: proba floor (0.40 = tighter/selective, 0.30 = looser)
PROBA_FLOOR_MIN=0.30

# Symbols to trade (comma separated)
AUTOTRADE_SYMBOLS=NQ,ES,RTY,YM,GC

# Protected symbols — never auto-dropped by the attribution agent
AUTOTRADE_PROTECTED_SYMBOLS=NQ,YM

# Quality gate from the 7B veto (0 = collect-only; the quality-band lever
# was KILLED by pre-registered experiment — see specs/selection-validation/)
AUTOTRADE_QUALITY_MIN=0
AUTOTRADE_VETO_MODE=advisory
AUTOTRADE_FAST_VETO=1
AUTOTRADE_VETO_FAIL_OPEN=1
AUTOTRADE_VETO_CAPTURE=1

# Edge monitor + consistency halt
AUTOTRADE_EDGE_MONITOR=1
CONSISTENCY_HALT=0

# Optional: entry-window gate 09:30-12:00 ET (0=off/24h, 1=on)
AUTOTRADE_ENTRY_WINDOW=0
# Optional: proba ceiling + chop cap (selection-evolution candidate config)
AUTOTRADE_PROBA_CEIL=0.65
AUTOTRADE_CHOP_MAX=2.0
